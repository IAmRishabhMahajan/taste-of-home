# Copy to .env for local development and fill in real values.
# .env is gitignored. In production, set these in your host's
# environment-variable settings (e.g. Vercel Project Settings > Environment Variables),
# NOT in a committed file.

# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/tasteofhome

# Port the API server listens on
PORT=5000

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Verified sender. Until a domain is verified in Resend, only
# "onboarding@resend.dev" works and it only delivers to your own account address.
RSVP_EMAIL_FROM=A Taste of Home <onboarding@resend.dev>

# Organiser page password and session signing secret
ORGANISER_PASSWORD=friendsgiving
SESSION_SECRET=change-me-to-a-long-random-string
